# Linux paths; copy to .env in the repository root before docker compose.
VV_DATA_PATH=/home/your-user/.local/share/video-viewer-dev/data
VV_MEDIA_PATH=/home/your-user/.local/share/video-viewer-dev/media
VV_CONFIG_PATH=/home/your-user/.local/share/video-viewer-dev/config
VV_SECRET_PATH=/home/your-user/.local/share/video-viewer-dev/passphrase
VV_UID=1000
VV_GID=1000
VV_PORT=8760
VV_BIND_ADDRESS=0.0.0.0
VV_SCAN_INTERVAL=300
VV_STABILITY_SECONDS=2
VV_MEDIA_STREAMS=4
VV_BACKUP_MAX_BYTES=33554432
