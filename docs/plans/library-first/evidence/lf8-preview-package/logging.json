{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {
      "format": "%(levelname)s %(message)s"
    },
    "path_only": {
      "()": "path_log.PathOnlyFormatter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "plain"
    },
    "access": {
      "class": "logging.FileHandler",
      "filename": "/trace/requests.jsonl",
      "formatter": "path_only"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "stderr"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "stderr"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [
        "access"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
