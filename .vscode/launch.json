{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Video Viewer (Android)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "deviceId": "emulator-5554",
      "preLaunchTask": "Prepare Android debug",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=LIBRARY_MODE=server"
      ]
    },
    {
      "name": "Video Viewer Demo (Android)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "deviceId": "emulator-5554",
      "preLaunchTask": "Start Android emulator",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=LIBRARY_MODE=demo"
      ]
    }
  ]
}
